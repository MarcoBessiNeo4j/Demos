false,"params":[{"name":"$cve_code","dataType":"String","suggestions":"property","cypher":null,"suggestionLabel":"CVE","suggestionProp":"cve_code","suggestionBoolean":false,"collapsed":false}],"hasCypherErrors":false},{"name":"Show code, runtime and business context for an application.","id":"tmpl:1776108910062","createdAt":1776108910062,"text":"Application $application_name exposure chain","cypher":"MATCH (app:Application {name: $application_name})\nOPTIONAL MATCH p1 = (app)-[:HAS_REPO]->(:Repository)-[:CONTAINS]->(:SastIssue)\nOPTIONAL MATCH p2 = (app)-[:HAS_REPO]->(:Repository)-[:CONTAINS]->(:Commit)-[:REFERENCES]->(:SastIssue)\nOPTIONAL MATCH p3 = (app)-[:HAS_REPO]->(:Repository)-[:CONTAINS]->(:File)-[:IMPORTS]->(:Library)<-[:AFFECTS]-(:CVE)\nOPTIONAL MATCH p4 = (app)-[:RUNNING_ON]->(:Software)<-[:AFFECTS]-(:CVE)\nOPTIONAL MATCH p5 = (app)-[:RUNNING_ON*1..3]->(:Server)\nOPTIONAL MATCH p6 = (app)<-[:USES]-(:Activity)<-[:CALLS]-(:BusinessProcess)\nRETURN app, p1, p2, p3, p4, p5, p6","isUpdateQuery":false,"isWriteTransactionChecked":false,"params":[{"name":"$application_name","dataType":"String","suggestions":"property","cypher":null,"suggestionLabel":"Application","suggestionProp":"name","suggestionBoolean":false,"collapsed":false}],"hasCypherErrors":false},{"name":"Show business process, supporting activities, applications, repos, SAST, CVEs and runtime.","id":"tmpl:1776108668573","createdAt":1776108668573,"text":"Process $business_process risk chain","cypher":"MATCH (bp:BusinessProcess {name: $business_process})\nOPTIONAL MATCH p1 = (bp)-[:CALLS]->(:Activity)-[:USES]->(:Application)\nOPTIONAL MATCH p2 = (bp)-[:CALLS]->(:Activity)-[:USES]->(:Application)-[:HAS_REPO]->(:Repository)-[:CONTAINS]->(:SastIssue)\nOPTIONAL MATCH p3 = (bp)-[:CALLS]->(:Activity)-[:USES]->(:Application)-[:HAS_REPO]->(:Repository)-[:CONTAINS]->(:File)-[:IMPORTS]->(:Library)<-[:AFFECTS]-(:CVE)\nOPTIONAL MATCH p4 = (bp)-[:CALLS]->(:Activity)-[:USES]->(:Application)-[:RUNNING_ON*1..3]->(:Server)\nOPTIONAL MATCH p5 = (bp)-[:CALLS]->(:Activity)-[:USES]->(:Application)-[:RUNNING_ON]->(:Software)<-[:AFFECTS]-(:CVE)\nRETURN bp, p1, p2, p3, p4, p5","isUpdateQuery":false,"isWriteTransactionChecked":false,"params":[{"name":"$business_process","dataType":"String","suggestions":"property","cypher":null,"suggestionLabel":"BusinessProcess","suggestionProp":"name","suggestionBoolean":false,"collapsed":false}],"hasCypherErrors":false}],"type":"STANDARD_PERSPECTIVE","version":"2.21.0"}
